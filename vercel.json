{
    "rewrites": [
        { "source": "/legal", "destination": "/index.html" },
        { "source": "/gasolineras", "destination": "/index.html" },
        { "source": "/gasolineras/:slug", "destination": "/index.html" },
        { "source": "/sitemap.xml", "destination": "https://api.gasoneclick.es/sitemap.xml" }
    ],
    "headers": [
        {
            "source": "/sitemap.xml",
            "headers": [
                {
                "key": "Content-Type",
                "value": "application/xml; charset=utf-8"
                }
            ]
        }
    ]
}
